# Normalize line endings to LF in the repo and in working trees, regardless of
# core.autocrlf. Shell scripts and Docker files break on CRLF inside Linux containers.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.db binary
*.sqlite binary
