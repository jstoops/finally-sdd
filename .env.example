# FinAlly configuration. Copy to .env (gitignored) and fill in values.
# Docker: injected by docker compose via env_file. Local dev: loaded from the repo root.

# Required for real LLM chat: OpenRouter API key.
# Without it (and with LLM_MOCK not "true"), POST /api/chat returns 503.
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in market simulator (recommended for most users).
MASSIVE_API_KEY=

# Optional: seconds between Massive polls (default 15, suits the free tier's 5 calls/min).
MASSIVE_POLL_INTERVAL=15

# Optional: set to "true" for deterministic mock LLM responses (testing, no API key needed).
LLM_MOCK=false

# Optional: SQLite file path. Defaults to <repo>/db/finally.db locally; the Dockerfile
# sets /app/db/finally.db. Leave this commented out: an empty DB_PATH= line would
# override the Dockerfile path and put the database outside the persistent volume.
# DB_PATH=

# Local development only; never set this in Docker. Lets `next dev` on :3000 call the
# backend on :8000 by enabling CORS for that one origin. Production stays single-origin.
# DEV_CORS_ORIGIN=http://localhost:3000
